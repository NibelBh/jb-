# Copiez ce fichier en .env.local et remplissez les valeurs.

# Clé secrète Stripe (Tableau de bord Stripe > Développeurs > Clés API).
# Utilisez d'abord la clé de test (sk_test_...), puis la clé live (sk_live_...) à l'ouverture.
STRIPE_SECRET_KEY=

# Adresse publique du site, sans barre finale. Ex. : https://www.tigerz.fr
# Sur Vercel, le domaine de production est utilisé automatiquement si elle est vide.
NEXT_PUBLIC_SITE_URL=
